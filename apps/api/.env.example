# Server
PORT=4000
NODE_ENV=development

# Supabase (PostgreSQL + Auth + pgvector)
# Replace with your project details from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Swappable AI Provider Configuration (OpenAI Spec Compatible)
# Supported options: openai | groq | together | openrouter | ollama | custom
# ==============================================================================
AI_PROVIDER_TYPE=openai

# Chat Completion Settings
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_API_KEY=sk-proj-your-openai-api-key
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_TEMPERATURE=0.3
AI_CHAT_MAX_TOKENS=1500

# Embedding Settings (Can point to OpenAI/Ollama even if Chat is Groq)
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=sk-proj-your-openai-api-key
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536

# RAG Hyperparameters
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# Examples of Swapping Providers:
#
# 1. Using GROQ for ultra-fast Chat + OpenAI for Embeddings:
# AI_PROVIDER_TYPE=groq
# AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
# AI_CHAT_API_KEY=gsk_your_groq_api_key
# AI_CHAT_MODEL=llama-3.3-70b-versatile
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=sk-proj-your-openai-key
# AI_EMBEDDING_MODEL=text-embedding-3-small
#
# 2. Using Local OLLAMA (100% offline & free):
# AI_PROVIDER_TYPE=ollama
# AI_CHAT_BASE_URL=http://localhost:11434/v1
# AI_CHAT_API_KEY=ollama
# AI_CHAT_MODEL=llama3.2
# AI_EMBEDDING_BASE_URL=http://localhost:11434/v1
# AI_EMBEDDING_API_KEY=ollama
# AI_EMBEDDING_MODEL=nomic-embed-text
# ------------------------------------------------------------------------------

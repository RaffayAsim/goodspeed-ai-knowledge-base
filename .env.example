# ==============================================================================
# AI-Powered Knowledge Base - Root Environment Blueprint
# Copy these values into apps/api/.env and apps/web/.env.local respectively
# ==============================================================================

# Supabase Settings (Shared)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend API (apps/api/.env)
PORT=4000
AI_PROVIDER_TYPE=openai
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_API_KEY=your-openai-or-groq-key
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=your-openai-key
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536

# Frontend Web (apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000/api
